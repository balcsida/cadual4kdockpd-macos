<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 window, published as one exe. Build on Windows: a release build of the engine with
       cargo, then dotnet publish -c Release -o ..\app (see ../README.md). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DockPatch</RootNamespace>
    <!-- Not "CADUAL4KDOCKPD-Patch": on Windows that is the same file name as the engine, cadual4kdockpd-patch.exe -->
    <AssemblyName>CADUAL4KDOCKPD-Patch-App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- Program.cs has the entry point, so that a failed start is reported instead of silent -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- No installer and no store package: one exe that runs on a PC with nothing installed. At its
         first start it unpacks itself into the user's temp folder. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- the Windows App SDK requires this for a single file: it puts the app's resource file inside -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Not named after the exe: the app would then fail to start whenever its file is renamed,
         for example to "...-App (1).exe" by a second download. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- The Windows App SDK needs the exe unpacked to disk (it sets IncludeAllContentForSelfExtract),
         so the .NET SDK's advice against that mode does not apply here. -->
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- the engine travels inside the exe and is unpacked next to the window's own files -->
    <None Include="..\target\release\cadual4kdockpd-patch.exe" Link="cadual4kdockpd-patch.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\target\release\cadual4kdockpd-patch.exe')" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the WinUI part of the Windows App SDK (it brings the two parts it needs). The whole SDK
         would add about 90 MB of AI, search and widget components this app never uses. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
  </ItemGroup>
</Project>
