<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 window. Build on Windows: dotnet build -c Release -o ..\app (see ../README.md). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DockPatch</RootNamespace>
    <!-- Not "CADUAL4KDOCKPD-Patch": on Windows that is the same file name as the engine, cadual4kdockpd-patch.exe -->
    <AssemblyName>CADUAL4KDOCKPD-Patch-App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- Program.cs has the entry point, so that a failed start is reported instead of silent -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- No installer and no store package: the published folder runs on a PC with nothing installed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>
</Project>
